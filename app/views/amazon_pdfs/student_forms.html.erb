<div class="min-h-[90vh] bg-white px-4 py-8 md:py-12">
  <div class="mx-auto w-full max-w-6xl space-y-10">
    <div class="space-y-4">
      <h1 class="text-center text-3xl font-extrabold tracking-tight text-blue-900 md:text-4xl [text-shadow:0_1px_0_rgba(220,38,38,0.85),0_-1px_0_rgba(220,38,38,0.85),1px_0_0_rgba(220,38,38,0.85),-1px_0_0_rgba(220,38,38,0.85)]">Student Forms</h1>
      <p class="mx-auto max-w-3xl text-center text-sm text-blue-900/80 md:text-base">
        Quick access to rehearsal and performance request forms, handbook agreements, and additional documents.
      </p>

      <% if current_director.present? %>
        <div class="flex justify-center pt-2">
          <%= link_to 'Upload New PDF', new_amazon_pdf_path, class: 'inline-flex items-center justify-center rounded-lg border border-red-400 bg-blue-700 px-6 py-3 text-base font-semibold text-white shadow-lg shadow-blue-900/20 transition hover:bg-blue-600' %>
        </div>
      <% end %>
    </div>

    <section class="space-y-5">
      <h2 class="text-center text-2xl font-bold tracking-tight text-blue-900 md:text-3xl">Absence Request Forms</h2>
      <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
        <article class="rounded-2xl border border-blue-300 bg-blue-50 p-5 text-blue-900 shadow-sm md:p-6">
          <div class="space-y-3">
            <div class="space-y-1">
              <h3 class="text-2xl font-bold">Night Rehearsal</h3>
              <p class="inline-flex rounded-full border border-red-400 bg-white px-3 py-1 text-xs font-semibold uppercase tracking-wide text-blue-900">Not all requests may be excused</p>
            </div>
            <p class="text-sm leading-relaxed text-blue-900/80 md:text-base">
              Please refer to our attendance policy for additional clarification. Requests must be submitted 1 hour prior to the scheduled rehearsal. Students with jobs need to communicate their school schedule with their employer. Academics and school events come first.
            </p>
            <div class="pt-2">
              <%= link_to 'Open Request Form', @school.rehearsal_absence_form, target: '_blank', class: 'inline-flex items-center justify-center rounded-lg border border-red-400 bg-blue-700 px-4 py-2 text-sm font-bold text-white transition hover:bg-blue-600' %>
            </div>
          </div>
        </article>

        <article class="rounded-2xl border border-blue-300 bg-blue-50 p-5 text-blue-900 shadow-sm md:p-6">
          <div class="space-y-3">
            <div class="space-y-1">
              <h3 class="text-2xl font-bold">Performances</h3>
              <p class="inline-flex rounded-full border border-red-400 bg-white px-3 py-1 text-xs font-semibold uppercase tracking-wide text-blue-900">Not all requests may be excused</p>
            </div>
            <p class="text-sm leading-relaxed text-blue-900/80 md:text-base">
              Please refer to our attendance policy for additional clarification. Requests must be submitted 2 weeks prior to the scheduled performance. Students with jobs need to communicate their school schedule with their employer. Academics and school events come first.
            </p>
            <div class="pt-2">
              <%= link_to 'Open Request Form', @school.performance_absence_form, target: '_blank', class: 'inline-flex items-center justify-center rounded-lg border border-red-400 bg-blue-700 px-4 py-2 text-sm font-bold text-white transition hover:bg-blue-600' %>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="space-y-5">
      <h2 class="text-center text-2xl font-bold tracking-tight text-blue-900 md:text-3xl">Handbook Contract</h2>
      <div class="mx-auto max-w-3xl">
        <article class="rounded-2xl border border-blue-300 bg-blue-50 p-5 text-blue-900 shadow-sm md:p-6">
          <div class="space-y-3">
            <h3 class="text-2xl font-bold">Form</h3>
            <p class="text-sm leading-relaxed text-blue-900/80 md:text-base">
              This electronic signature serves as your signature stating that you (student) have read, understand and agree to abide by the Instrumental Music Handbook.
            </p>
            <div class="pt-2">
              <%= link_to 'Open Handbook Form', @school.handbook_contract_form, target: '_blank', class: 'inline-flex items-center justify-center rounded-lg border border-red-400 bg-blue-700 px-4 py-2 text-sm font-bold text-white transition hover:bg-blue-600' %>
            </div>
          </div>
        </article>
      </div>
    </section>

    <% if @amazon_pdfs.present? %>
      <% @amazon_pdfs.group_by { |g| g.type_of_pdf_group }.each do |group, pdfs| %>
        <section class="space-y-5">
          <h2 class="text-center text-2xl font-bold tracking-tight text-blue-900 md:text-3xl"><%= group.to_s.upcase %></h2>
          <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
            <% pdfs.each do |pdf| %>
              <article class="rounded-2xl border border-blue-300 bg-blue-50 p-5 text-blue-900 shadow-sm md:p-6">
                <div class="space-y-3">
                  <h3 class="text-xl md:text-2xl font-bold"><%= pdf.name %></h3>
                  <div>
                    <% if pdf.linked_document? %>
                      <span class="inline-flex rounded-full border border-emerald-300 bg-emerald-50 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-emerald-700">Google Doc</span>
                    <% else %>
                      <span class="inline-flex rounded-full border border-blue-300 bg-white px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-blue-700">PDF</span>
                    <% end %>
                  </div>
                  <p class="text-sm leading-relaxed text-blue-900/80 md:text-base">
                    Read through the following document and choose the assignment to complete. Assignment should be turned in one week after the date of the performance.
                  </p>
                  <div class="flex flex-wrap gap-3 pt-2">
                    <%= link_to(pdf.linked_document? ? 'Preview Google Doc' : 'Preview PDF', pdf.url, target: '_blank', class: 'inline-flex items-center justify-center rounded-lg border border-red-400 bg-blue-700 px-4 py-2 text-sm font-bold text-white transition hover:bg-blue-600') %>
                    <% if current_director.present? %>
                      <%= link_to 'Delete', amazon_pdf_path(pdf.id), data: { turbo_method: :delete, turbo_confirm: 'Are you sure you want to remove this PDF?' }, class: 'inline-flex items-center justify-center rounded-lg border border-red-400 bg-red-600 px-4 py-2 text-sm font-bold text-white transition hover:bg-red-500' %>
                    <% end %>
                  </div>
                </div>
              </article>
            <% end %>
          </div>
        </section>
      <% end %>
    <% end %>
  </div>
</div>