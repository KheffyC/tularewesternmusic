<section class="w-full bg-white px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
  <div class="mx-auto w-[94%] sm:w-[90%] lg:w-[80%]">

    <div class="mb-10 text-center sm:mb-14">
      <h2 class="font-display text-4xl font-bold tracking-tight text-blue-900 [text-shadow:0_1px_0_rgba(255,0,0,0.95),0_-1px_0_rgba(255,0,0,0.95),1px_0_0_rgba(255,0,0,0.95),-1px_0_0_rgba(255,0,0,0.95)] sm:text-6xl lg:text-8xl">Band Periods</h2>
      <% if @school.about.present? %>
        <p class="section-subtitle mx-auto mt-4 max-w-3xl text-slate-700"><%= @school.about %></p>
      <% end %>
    </div>

    <div class="space-y-6 lg:space-y-8">
      <% @school.programs.order(:period).each_with_index do |program, index| %>
        <% unless index.zero? %>
          <hr class="border-t-2 border-red-300/70" />
        <% end %>

        <div class="flex flex-col gap-6 py-6 sm:flex-row sm:gap-8 lg:gap-10 lg:py-8">
          <div class="relative h-56 w-full shrink-0 overflow-hidden sm:h-64 sm:w-64 lg:h-72 lg:w-72">
            <%= image_tag(
              resolve_image_src(
                program.main_gallery_image_url&.strip.presence,
                fallback: @school.default_image.to_s.strip.presence || 'default-hero.jpg'
              ),
              alt: program.description,
              class: 'h-full w-full object-cover'
            ) %>
          </div>

          <div class="flex flex-1 flex-col justify-center gap-3">
            <div class="flex flex-wrap items-center gap-2">
              <span class="inline-flex items-center rounded-full bg-red-600/10 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-red-700">
                Period <%= program.period %>
              </span>
              <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-700">
                <%= program.description %>
              </span>
            </div>

            <h3 class="text-2xl font-bold text-slate-900 sm:text-3xl"><%= program.hero_title %></h3>

            <% if program.detailed_description.present? %>
              <p class="text-sm leading-relaxed text-slate-700 sm:text-base"><%= program.detailed_description %></p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

  </div>
</section>