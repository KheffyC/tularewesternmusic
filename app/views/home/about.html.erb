<%= render 'hero', school: @school, page_title: 'Class Schedule', hero_image_override: @school.about_hero_image %>

<section class="w-full bg-white px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
  <div class="mx-auto w-[94%] sm:w-[90%] lg:w-[80%]">

    <div class="mb-10 text-center sm:mb-14">
      <h2 class="section-title text-blue-700">Band Periods</h2>
      <% if @school.about.present? %>
        <p class="section-subtitle mx-auto mt-4 max-w-3xl text-slate-700"><%= @school.about %></p>
      <% end %>
    </div>

    <div class="space-y-6 lg:space-y-8">
      <% @school.programs.order(:period).each_with_index do |program, i| %>
        <%= link_to program_path(program), class: 'group block' do %>
        <article class="flex flex-col overflow-hidden border border-blue-300/60 bg-blue-100 shadow-[0_12px_24px_rgba(30,64,175,0.18)] transition duration-300 hover:shadow-[0_18px_34px_rgba(30,64,175,0.26)] sm:flex-row">

          <%# Image — alternate side on desktop for visual rhythm %>
          <div class="relative h-56 w-full shrink-0 overflow-hidden sm:h-64 sm:w-64 lg:h-72 lg:w-80 <%= i.odd? ? 'sm:order-last' : '' %>">
            <%= image_tag(
              resolve_image_src(
                program.main_gallery_image_url&.strip.presence,
                fallback: @school.default_image.to_s.strip.presence || 'default-hero.jpg'
              ),
              alt: program.description,
              class: 'h-full w-full object-cover transition duration-500 group-hover:scale-105'
            ) %>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-blue-900/60 to-transparent sm:bg-gradient-to-r sm:from-transparent sm:to-blue-900/30"></div>
          </div>

            <div class="flex flex-1 flex-col justify-between gap-4 p-6 sm:p-8 lg:p-10">
            <div>
              <div class="mb-3 flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center rounded-full bg-white/90 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-900">
                  Period <%= program.period %>
                </span>
                <span class="inline-flex items-center rounded-full bg-white/70 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-700">
                  <%= program.description %>
                </span>
              </div>

              <h3 class="text-2xl font-bold text-slate-900 sm:text-3xl"><%= program.hero_title %></h3>

              <% if program.detailed_description.present? %>
                <p class="mt-3 text-sm leading-relaxed text-slate-700 sm:text-base"><%= program.detailed_description %></p>
              <% end %>
            </div>

            </div>
          </article>
        <% end %>
      <% end %>
    </div>

  </div>
</section>