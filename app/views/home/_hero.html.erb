<%
  hero_image_override = local_assigns[:hero_image_override].to_s.strip.presence

  hero_image = hero_image_override || if local_assigns[:program]
    @program.main_gallery_image_url.presence || @program.about_image_url.presence || @school.default_image
  else
    @school.default_image.presence || @school.home_page_image_urls.to_s.split(',').first
  end

  hero_image = resolve_image_src(hero_image)
%>

<section
  class="relative h-[calc(100vh-88px)] overflow-hidden bg-blue-950 bg-cover bg-center bg-no-repeat sm:h-[calc(100vh-88px)] lg:h-[calc(100vh-104px)]"
  style="background-image: url('<%= hero_image %>');">
  <div class="absolute inset-0 bg-blue-950/30"></div>
  <div class="relative z-10 mx-auto flex h-full w-full max-w-full items-center justify-center px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl px-2 py-8 text-center sm:px-4 sm:py-10 lg:py-14">
      <h1 class="font-display text-4xl font-bold tracking-tight text-red-900 [text-shadow:0_1px_0_rgba(255,255,255,0.95),0_-1px_0_rgba(255,255,255,0.95),1px_0_0_rgba(255,255,255,0.95),-1px_0_0_rgba(255,255,255,0.95),0_4px_22px_rgba(0,0,0,0.98)] sm:text-6xl lg:text-8xl">
        <%= local_assigns[:page_title] ? page_title : @school.hero_title %>
      </h1>

      <% if local_assigns[:page_hero_title] && page_hero_title.present? %>
        <p class="mt-4 text-base font-light leading-relaxed text-white/95 [text-shadow:0_2px_14px_rgba(0,0,0,0.95)] sm:mt-5 sm:text-xl lg:mt-6 lg:text-2xl">
          <%= page_hero_title %>
        </p>
      <% end %>
    </div>
  </div>
</section>
