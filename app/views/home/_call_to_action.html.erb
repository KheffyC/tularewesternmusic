<section class="w-full bg-white px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
  <div class="mx-auto mb-8 w-[94%] text-center sm:mb-10 sm:w-[90%] lg:w-[80%]">
    <h2 class="section-title text-blue-900 [text-shadow:0_1px_0_rgba(220,38,38,0.9),0_-1px_0_rgba(220,38,38,0.9),1px_0_0_rgba(220,38,38,0.9),-1px_0_0_rgba(220,38,38,0.9)]">Support our students</h2>
    <p class="section-subtitle text-slate-600">Two ways to help keep <%= school.name %> Music thriving.</p>
  </div>

  <div class="mx-auto grid w-[94%] grid-cols-1 gap-5 sm:w-[90%] lg:w-[80%] lg:grid-cols-2 lg:gap-6">
    <article class="group relative overflow-hidden rounded-2xl border-2 border-red-500 bg-blue-950 shadow-[0_20px_45px_rgba(30,58,138,0.35)]">
      <div class="aspect-[4/5] w-full overflow-hidden bg-blue-950 sm:h-[420px] sm:aspect-auto lg:h-[580px]">
        <%= image_tag 'ag_show.jpg', alt: 'Band arc together', class: 'h-full w-full object-cover transition duration-500 group-hover:scale-105' %>
      </div>

      <div class="pointer-events-none absolute inset-0 bg-black/25"></div>

      <div class="absolute inset-x-0 bottom-0 z-10 p-5 sm:p-6">
        <p class="inline-flex bg-white/90 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-gray-900">Donations</p>
        <h3 class="mt-3 text-2xl font-bold text-white sm:text-3xl">Support Our Young Musicians</h3>
        <p class="mt-2 text-base text-white/90"><strong><em>We Are Better Together</em></strong></p>
        <p class="mt-1 text-sm leading-relaxed text-white sm:text-base"><%= school.call_to_action %></p>

        <% if donations_enabled? %>
          <div class="mt-4">
            <%= link_to 'Donate Today', donations_path, class: 'inline-block border border-red-300 bg-red-500/15 px-4 py-2 text-sm font-semibold uppercase tracking-wide text-white transition hover:bg-red-500/30' %>
          </div>
        <% end %>
      </div>
    </article>

    <article class="group relative overflow-hidden rounded-2xl border-2 border-red-500 bg-blue-950 shadow-[0_20px_45px_rgba(30,58,138,0.35)]">
      <div class="aspect-[4/5] w-full overflow-hidden bg-blue-950 sm:h-[420px] sm:aspect-auto lg:h-[580px]">
        <%= image_tag 'football_player.webp', alt: 'Group photo of band members', class: 'h-full w-full object-contain transition duration-500 group-hover:scale-105' %>
      </div>

      <div class="pointer-events-none absolute inset-0 bg-black/25"></div>

      <div class="absolute inset-x-0 bottom-0 z-10 p-5 sm:p-6">
        <p class="inline-flex bg-white/90 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-gray-900">Contact</p>
        <h3 class="mt-3 text-2xl font-bold text-white sm:text-3xl">Get In Touch</h3>
        <p class="mt-2 text-base text-white/90"><strong><em>Have a question?</em></strong></p>
        <p class="mt-1 text-sm leading-relaxed text-white sm:text-base"><%= school.contact_us %></p>

        <div class="mt-4">
          <%= link_to 'Contact Us', contacts_path, class: 'inline-block border border-cyan-300 bg-cyan-400/10 px-4 py-2 text-sm font-semibold uppercase tracking-wide text-white transition hover:bg-cyan-500/25' %>
        </div>
      </div>
    </article>
  </div>
</section>
