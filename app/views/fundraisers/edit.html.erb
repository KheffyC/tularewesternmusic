<div
  class="min-h-screen bg-white px-4 py-8 md:py-12"
  x-data="{
    isDragging: false,
    selectedFileName: '',
    setFiles(files) {
      if (!files || !files.length) return;
      this.$refs.flyerInput.files = files;
      this.selectedFileName = files[0].name;
    },
    handleDrop(event) {
      this.isDragging = false;
      this.setFiles(event.dataTransfer.files);
    }
  }"
>
  <div class="mx-auto w-full max-w-3xl space-y-6">
    <div class="flex items-center gap-3">
      <%= link_to '← Back to Fundraiser', fundraiser_path(@fundraiser), class: 'text-sm font-semibold text-blue-900 transition hover:text-blue-700' %>
    </div>
    <div class="space-y-1">
      <h1 class="text-3xl font-extrabold tracking-tight text-blue-900 md:text-4xl [text-shadow:0_1px_0_rgba(220,38,38,0.85),0_-1px_0_rgba(220,38,38,0.85),1px_0_0_rgba(220,38,38,0.85),-1px_0_0_rgba(220,38,38,0.85)]">Edit Fundraiser</h1>
      <p class="text-sm text-blue-900/80">Update the details for <span class="font-semibold text-blue-900"><%= @fundraiser.title %></span>.</p>
    </div>

    <%= simple_form_for @fundraiser, url: fundraiser_path(@fundraiser), method: :patch, html: { class: "space-y-6 rounded-2xl border border-blue-300 bg-white p-5 text-blue-900 shadow-xl md:p-8", autocomplete: 'off', multipart: true } do |form| %>

      <%= render 'form', form: form %>

      <div class="pt-2 flex flex-wrap gap-3">
        <%= form.submit "Save Changes", class: "inline-flex items-center justify-center rounded-lg border border-red-400 bg-blue-700 px-6 py-2.5 text-sm font-bold text-white shadow-lg shadow-blue-900/30 transition hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-300/70" %>
        <%= link_to "Cancel", fundraiser_path(@fundraiser), class: "inline-flex items-center justify-center rounded-lg border border-blue-300 bg-white px-6 py-2.5 text-sm font-semibold text-blue-900 transition hover:bg-blue-50" %>
      </div>
    <% end %>
  </div>
</div>
