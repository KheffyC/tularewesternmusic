<div class="min-h-screen bg-white px-4 py-8 md:py-12">
  <div class="mx-auto w-full max-w-4xl space-y-8">

    <div class="flex items-center gap-3">
      <%= link_to '← All Fundraisers', fundraisers_path, class: 'text-sm font-semibold text-blue-900 transition hover:text-blue-700' %>
    </div>

    <article class="overflow-hidden rounded-2xl border border-blue-300 bg-white shadow-xl">
      <% if @fundraiser.flyer.attached? || @fundraiser.main_image.present? %>
        <div class="aspect-video w-full overflow-hidden bg-blue-100">
          <% if @fundraiser.flyer.attached? %>
            <%= image_tag @fundraiser.flyer, class: "h-full w-full object-cover" %>
          <% else %>
            <img src="<%= @fundraiser.main_image %>" alt="<%= @fundraiser.title %>" class="h-full w-full object-cover">
          <% end %>
        </div>
      <% end %>

      <div class="space-y-6 p-6 md:p-8">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="space-y-1">
            <h1 class="text-2xl font-extrabold tracking-tight text-blue-900 md:text-3xl"><%= @fundraiser.title %></h1>
            <p class="text-sm font-semibold text-blue-700">
              <%= @fundraiser.program.short_name.presence || @fundraiser.program.name %>
            </p>
          </div>
          <% if @fundraiser.active? %>
            <span class="rounded-full border border-red-400 bg-blue-100 px-3 py-1 text-sm font-semibold text-blue-900">Active</span>
          <% else %>
            <span class="rounded-full border border-blue-300 bg-white px-3 py-1 text-sm font-semibold text-blue-700">Ended</span>
          <% end %>
        </div>

        <% if @fundraiser.start_date.present? || @fundraiser.end_date.present? %>
          <div class="flex flex-wrap gap-6 text-sm text-blue-900/75">
            <% if @fundraiser.start_date.present? %>
              <div>
                <span class="block text-xs font-semibold uppercase tracking-wide text-blue-700/80">Start Date</span>
                <span class="font-medium text-blue-900"><%= @fundraiser.start_date.strftime('%B %-d, %Y') %></span>
              </div>
            <% end %>
            <% if @fundraiser.end_date.present? %>
              <div>
                <span class="block text-xs font-semibold uppercase tracking-wide text-blue-700/80">End Date</span>
                <span class="font-medium text-blue-900"><%= @fundraiser.end_date.strftime('%B %-d, %Y') %></span>
              </div>
            <% end %>
          </div>
        <% end %>

        <% if @fundraiser.goal.present? %>
          <div class="rounded-xl border border-red-400 bg-blue-50 px-5 py-4">
            <span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-blue-700">Goal</span>
            <p class="text-lg font-bold text-blue-900"><%= @fundraiser.goal %></p>
          </div>
        <% end %>

        <% if @fundraiser.description.present? %>
          <div class="space-y-2">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-blue-700">About This Fundraiser</h2>
            <p class="whitespace-pre-wrap text-base leading-relaxed text-blue-900/80"><%= @fundraiser.description %></p>
          </div>
        <% end %>

        <% if @fundraiser.call_to_action.present? %>
          <div class="rounded-xl border border-red-400 bg-blue-50 px-5 py-4">
            <p class="text-base font-semibold text-blue-900"><%= @fundraiser.call_to_action %></p>
          </div>
        <% end %>

        <% if current_director.present? %>
          <div class="flex flex-wrap gap-3 border-t border-blue-200 pt-5">
            <%= link_to 'Edit Fundraiser', edit_fundraiser_path(@fundraiser), class: 'inline-flex items-center justify-center rounded-lg border border-blue-300 bg-blue-100 px-5 py-2.5 text-sm font-semibold text-blue-900 transition hover:bg-blue-200' %>
            <%= link_to 'Delete', fundraiser_path(@fundraiser), data: { turbo_method: :delete, turbo_confirm: "Remove #{@fundraiser.title}?" }, class: 'inline-flex items-center justify-center rounded-lg border border-red-400 bg-red-600 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-red-500' %>
          </div>
        <% end %>
      </div>
    </article>

  </div>
</div>
