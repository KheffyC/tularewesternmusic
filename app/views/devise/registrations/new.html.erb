<div class="min-h-screen bg-white flex items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
  <div class="w-full max-w-md bg-white rounded-2xl shadow-2xl p-8 sm:p-10">
    <div class="text-center mb-8">
      <h1 class="font-display text-4xl font-bold text-gray-900 mb-2">Create Account</h1>
      <p class="text-gray-600">Temporary Director Login</p>
    </div>

    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), local: true) do |f| %>
      <%= f.error_notification %>

      <div class="space-y-6">
        <!-- Email Input -->
        <div>
          <%= f.label :email, class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.email_field :email,
                            required: true,
                            autofocus: true,
                            class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition",
                            autocomplete: "email" %>
        </div>

        <!-- Password Input -->
        <div>
          <%= f.label :password, class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.password_field :password,
                               required: true,
                               class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition",
                               autocomplete: "new-password" %>
          <% if @minimum_password_length %>
            <p class="mt-2 text-xs text-gray-600"><%= @minimum_password_length %> characters minimum</p>
          <% end %>
        </div>

        <!-- Password Confirmation Input -->
        <div>
          <%= f.label :password_confirmation, class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.password_field :password_confirmation,
                               required: true,
                               class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition",
                               autocomplete: "new-password" %>
        </div>

        <!-- Submit Button -->
        <div class="pt-4">
          <%= f.button :submit, "Sign Up", class: "w-full bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 py-3 px-4 font-bold text-white rounded-lg transition duration-200 hover:shadow-lg" %>
        </div>
      </div>
    <% end %>

    <!-- Links -->
    <div class="mt-8 pt-6 border-t border-gray-200">
      <div class="space-y-4 text-center text-sm">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
