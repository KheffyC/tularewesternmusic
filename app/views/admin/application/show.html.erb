<% resource = page.resource rescue nil %>
<% dashboard ||= resource ? "#{resource.class}Dashboard".constantize.new : nil rescue nil %>
<% page_title = resource&.class&.model_name&.singular.titleize || "Resource"
show_new_button = false
show_back_button = true
show_breadcrumb = true %>

<%= render "admin/application/header", page_title: page_title, dashboard: dashboard, resource: resource, show_new_button: show_new_button, show_back_button: show_back_button, show_breadcrumb: show_breadcrumb %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
  <!-- Edit Form -->
  <div class="lg:col-span-2">
    <div class="bg-white rounded-lg shadow-md p-8">
      <%= render "admin/application/form", resource: resource, dashboard: dashboard %>
    </div>
  </div>

  <!-- Sidebar Actions -->
  <div class="lg:col-span-1">
    <div class="bg-white rounded-lg shadow-md p-6 sticky top-8">
      <h3 class="font-display text-lg font-bold text-gray-900 mb-4">Information</h3>
      <p class="text-sm text-gray-600">
        Created: <%= resource.created_at&.strftime("%B %d, %Y") %>
      </p>
      <p class="text-sm text-gray-600 mt-2">
        Last updated: <%= resource.updated_at&.strftime("%B %d, %Y at %I:%M %p") %>
      </p>
      <hr class="my-4" />
      
      <div class="space-y-3">
        <% back_path = dashboard ? send("admin_#{dashboard.class.name.gsub(/Dashboard$/, '').underscore.pluralize}_path") : admin_root_path %>
        <%= link_to "← Back to List", back_path, 
            class: "block w-full px-4 py-3 text-center bg-gray-300 hover:bg-gray-400 text-gray-800 font-semibold rounded-lg transition" %>
        
        <% resource_name = dashboard&.class&.name&.gsub(/Dashboard$/, '') || resource.class.model_name.singular %>
        <%= link_to "🗑️ Delete", polymorphic_path([:admin, resource]), 
            method: :delete, 
            data: { confirm: "Are you sure you want to delete this #{resource_name.downcase}?" },
            class: "block w-full px-4 py-3 text-center bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition" %>
      </div>
    </div>
  </div>
</div>
