<div class="mb-8 flex items-center justify-between">
  <div>
    <h1 class="font-display text-3xl font-bold text-gray-900"><%= page_title.titleize %></h1>
    <% if show_breadcrumb %>
      <nav class="mt-2 text-sm text-gray-600">
        <%= link_to "Admin", admin_root_path, class: "hover:text-gray-900" %> / 
        <% if dashboard %>
          <% resource_name = dashboard.class.name.gsub(/Dashboard$/, '').underscore.pluralize %>
          <%= link_to resource_name.humanize, send("admin_#{resource_name}_path"), class: "hover:text-gray-900" %>
          <% if resource&.persisted? %>
            / <%= truncate(resource.to_s, length: 50) %>
          <% end %>
        <% else %>
          <%= page_title.titleize %>
        <% end %>
      </nav>
    <% end %>
  </div>

  <div class="flex items-center space-x-4">
    <% if show_new_button && dashboard %>
      <% resource_name = dashboard.class.name.gsub(/Dashboard$/, '') %>
      <%= link_to "+ New #{resource_name}", send("new_admin_#{resource_name.underscore}_path"), 
          class: "px-6 py-3 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-emerald-600 hover:to-emerald-700 text-white font-bold rounded-lg transition shadow-md" %>
    <% end %>
    
    <% if show_back_button %>
      <% if dashboard %>
        <% resource_name = dashboard.class.name.gsub(/Dashboard$/, '').underscore.pluralize %>
        <%= link_to "← Back", send("admin_#{resource_name}_path"), 
            class: "px-4 py-3 bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold rounded-lg transition" %>
      <% else %>
        <%= link_to "← Back", admin_root_path, 
            class: "px-4 py-3 bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold rounded-lg transition" %>
      <% end %>
    <% end %>
  </div>
</div>
