<%= render 'home/hero', program: @program, page_title: @program.short_name, page_hero_title: @program.hero_title %>

<section class="w-full bg-white px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
  <div class="mx-auto w-[94%] sm:w-[90%] lg:w-[80%]">
    <div class="mb-10 text-center sm:mb-14">
      <h2 class="section-title text-blue-900">About The Program</h2>
      <p class="section-subtitle mx-auto max-w-3xl text-slate-600"><%= @program.hero_title %></p>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1.1fr_0.9fr] lg:gap-8">
      <article class="overflow-hidden bg-blue-950 shadow-[0_14px_30px_rgba(30,58,138,0.35)]">
        <div class="p-6 sm:p-8 lg:p-10">
          <span class="inline-flex rounded-full bg-white/10 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-white/70">
            Program Overview
          </span>
          <h3 class="mt-4 text-2xl font-bold text-white sm:text-3xl"><%= @program.short_name %></h3>
          <div class="mt-5 text-base leading-relaxed text-white/80 sm:text-lg">
            <%= @program.detailed_description %>
          </div>

          <div class="mt-7 flex flex-col gap-4 sm:flex-row sm:items-stretch">
            <div class="flex min-h-[220px] flex-1 flex-col border border-blue-400/30 bg-blue-500/10 p-5 sm:min-h-[250px] sm:p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-100">Get Involved</p>
              <p class="mt-2 text-sm leading-relaxed text-white sm:text-base">Interested in joining this class?</p>
              <%= link_to 'Apply Here', contacts_path, class: 'mt-auto inline-flex w-full items-center justify-center border border-blue-300/50 px-4 py-3 text-base font-semibold text-white transition hover:bg-blue-500/25' %>
            </div>

            <div class="flex min-h-[220px] flex-1 flex-col border border-emerald-400/30 bg-emerald-500/10 p-5 sm:min-h-[250px] sm:p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-emerald-100">Support This Program</p>
              <p class="mt-2 text-sm leading-relaxed text-white sm:text-base"><%= @program.program_support_text.presence || 'Help fund instruments, trips, and performances.' %></p>
              <% if donations_enabled? %>
                <%= link_to 'Donate', donations_path, class: 'mt-auto inline-flex w-full items-center justify-center border border-emerald-300/50 px-4 py-3 text-base font-semibold text-white transition hover:bg-emerald-500/25' %>
              <% end %>
            </div>
          </div>
        </div>
      </article>

      <article class="group relative overflow-hidden bg-blue-950 shadow-[0_14px_30px_rgba(30,58,138,0.35)]">
        <div class="h-80 w-full overflow-hidden sm:h-[420px] lg:h-[460px]">
          <% program_image = @program.about_image_url.to_s.strip.presence || @program.main_gallery_image_url.to_s.strip.presence || @school.default_image.to_s.strip.presence || 'default-hero.jpg' %>
          <%= image_tag(
            resolve_image_src(program_image),
            alt: "#{@program.short_name} program photo",
            class: 'h-full w-full object-cover transition duration-500 group-hover:scale-105'
          ) %>
        </div>
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-blue-950/80 via-blue-900/20 to-transparent"></div>
      </article>
    </div>
  </div>
</section>

<section class="w-full bg-gray-100 px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
  <div class="mx-auto w-[94%] sm:w-[90%] lg:w-[80%]">
    <div class="mb-8 grid grid-cols-1 gap-4 sm:mb-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-end lg:gap-8">
      <div class="text-center lg:text-left">
        <h2 class="section-title text-gray-900">Plan the School Year here</h2>
        <p class="mt-3 text-lg leading-relaxed text-gray-700 sm:text-xl">
          Rehearsals, performances, and paperwork all live here so students and families can stay prepared without missing key deadlines.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div class="border border-gray-200 bg-white p-3 text-center shadow-[0_8px_20px_rgba(15,23,42,0.08)]">
          <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-gray-500">Program</p>
          <p class="mt-1 text-sm font-semibold text-gray-900"><%= @program.short_name %></p>
        </div>
        <div class="border border-gray-200 bg-white p-3 text-center shadow-[0_8px_20px_rgba(15,23,42,0.08)]">
          <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-gray-500">Circuit</p>
          <p class="mt-1 text-sm font-semibold text-gray-900"><%= @program.circuit.presence || 'TBA' %></p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1.35fr_0.65fr] lg:gap-6">
      <% if @program.calendar_url.present? || @program.school.calendar_url.present? %>
        <article class="overflow-hidden border-2 border-gray-300 bg-white p-2 shadow-[0_10px_24px_rgba(15,23,42,0.12)]">
          <div class="h-[48vh] overflow-x-auto overflow-y-hidden bg-gray-100 sm:h-[68vh] lg:h-[75vh]">
            <iframe
              class="h-full w-[860px] min-w-[860px] sm:min-w-0 sm:w-full"
              src="<%= @program.calendar_url || @program.school.calendar_url %>"
              style="border:0;"
              frameborder="0"
              scrolling="no"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </article>
      <% else %>
        <article class="flex min-h-[320px] items-center justify-center border-2 border-dashed border-gray-300 bg-white p-6 text-center text-gray-600">
          Calendar coming soon.
        </article>
      <% end %>

      <aside class="bg-white p-5 text-gray-700 shadow-[0_10px_24px_rgba(15,23,42,0.12)] sm:p-6">
        <h3 class="text-xl font-bold text-gray-900"><%= @program.short_name %> Information Hub</h3>
        <p class="mt-2 text-sm leading-relaxed text-gray-600">
          Use these quick links for forms, itineraries, and shared files related to this program.
        </p>

        <div class="mt-4 border border-gray-200 bg-gray-50 p-3">
          <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-gray-500">Quick Actions</p>
          <div class="mt-2 grid grid-cols-1 gap-2">
            <%= link_to 'Contact Directors', contacts_path, class: 'block border border-white bg-blue-700 px-3 py-2 text-center text-xs font-semibold text-white transition hover:bg-blue-600' %>
            <%= link_to 'Support Fundraising', fundraisers_path, class: 'block border border-gray-300 px-3 py-2 text-center text-xs font-semibold text-gray-700 transition hover:border-gray-500 hover:text-gray-900' %>
          </div>
        </div>

        <% if current_director.present? %>
          <div
            class="mt-4 border border-white bg-white p-3"
            x-data="{ fileName: '', docName: '', onFile(e) { const file = e.target.files[0]; if (!file) return; this.fileName = file.name; if (!this.docName) { this.docName = file.name.replace(/\.pdf$/i, '').replace(/[_-]+/g, ' '); } }, onDrop(e) { e.preventDefault(); const files = e.dataTransfer.files; if (!files.length) return; this.$refs.fileInput.files = files; this.onFile({ target: { files: files } }); } }"
          >
            <div class="flex items-center justify-between gap-2">
              <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-blue-900">Director Upload</p>
              <%= link_to '+ Add Program Documents', new_amazon_pdf_path(program_id: @program.id), class: 'text-[11px] font-semibold text-blue-700 underline decoration-blue-300 underline-offset-2 hover:text-red-600' %>
            </div>

            <%= form_with url: amazon_pdfs_path, scope: :amazon_pdf, local: true, html: { multipart: true, class: 'mt-3 space-y-3' } do |form| %>
              <%= form.hidden_field :program_id, value: @program.id %>
              <%= form.hidden_field :type_of_pdf_group, value: 'Other' %>
              <%# Return to this program after a successful inline upload. %>
              <%= form.hidden_field :return_to, value: program_path(@program) %>

              <label
                class="flex cursor-pointer flex-col items-center justify-center border border-dashed border-blue-200 bg-blue-50 px-3 py-4 text-center"
                @dragover.prevent
                @drop="onDrop($event)"
                @click="$refs.fileInput.click()"
              >
                <span class="text-[11px] font-semibold uppercase tracking-[0.16em] text-blue-900">Drop PDF Here</span>
                <span class="mt-1 text-xs text-gray-700" x-text="fileName || 'or click to choose a file'"></span>
              </label>

              <%= form.file_field :pdf, accept: 'application/pdf', class: 'hidden', 'x-ref': 'fileInput', '@change': 'onFile($event)' %>

              <div>
                <%= form.label :name, 'Document Name', class: 'block text-xs font-semibold uppercase tracking-[0.16em] text-gray-700' %>
                <%= form.text_field :name, class: 'mt-1 w-full border border-blue-200 bg-white px-3 py-2 text-sm text-gray-900', placeholder: 'e.g. October Rehearsal Schedule', 'x-model': 'docName' %>
              </div>

              <%= form.submit 'Upload to This Program', class: 'w-full bg-blue-700 px-3 py-2 text-sm font-semibold text-white transition hover:bg-blue-800' %>
            <% end %>
          </div>
        <% end %>

        <% if @program.amazon_pdfs.present? %>
          <div class="mt-4 space-y-3">
            <% @program.amazon_pdfs.each do |pdf| %>
              <div class="space-y-4 border border-blue-300 bg-gradient-to-r from-blue-50 to-white p-3 shadow-[0_8px_18px_rgba(127,29,29,0.12)]">
                <%= link_to pdf.name, pdf&.url, target: '_blank', class: 'block bg-blue-700 px-3.5 py-2 text-xs font-semibold text-white transition hover:bg-blue-800 sm:text-sm' %>
                <% if current_director.present? %>
                  <%= link_to "Delete #{pdf.name}", amazon_pdf_path(pdf.id), data: { turbo_method: :delete, turbo_confirm: 'are you sure?' }, class: 'block mt-2 border border-red-300 bg-red-600 px-3 py-1.5 text-center text-xs font-semibold text-white transition hover:bg-red-500' %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="mt-4 text-sm text-gray-600">No documents posted yet.</p>
        <% end %>
      </aside>
    </div>
  </div>
</section>

<section class="w-full bg-white px-4 py-16 text-center sm:px-6 sm:py-20 lg:px-8 lg:py-24">
  <div class="mx-auto w-[94%] sm:w-[90%] lg:w-[80%]">
    <h2 class="section-title text-blue-900">Stay Connected</h2>
    <p class="section-subtitle text-slate-600">
      Follow the <%= @program.short_name %> at <%= @program.ig_handle.presence || '@tuhsinstrumentalmusic' %>
      <% if @program.circuit.present? %>
        and catch us around the Central Valley in <%= @program.circuit %> competitions.
      <% end %>
    </p>
  </div>
</section>

