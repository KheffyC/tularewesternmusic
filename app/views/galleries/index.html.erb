<div class="min-h-screen bg-white py-12 px-4">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col md:items-center md:justify-center mb-8 gap-4">
      <h1 class="text-4xl md:text-5xl font-display font-bold text-blue-900">
        Media Gallery
      </h1>
      <% if current_director.present? %>
        <%= link_to 'Add images to Gallery', admin_galleries_path, class: "inline-block rounded-lg border border-white px-6 py-3 bg-blue-700 text-white font-semibold transition-colors hover:border-emerald-600 hover:bg-emerald-600 hover:text-white" %>
      <% end %>
    </div>

    <% if @galleries.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @galleries.each do |gallery| %>
          <%= link_to gallery_path(gallery), class: "group" do %>
            <div class="bg-white rounded-lg overflow-hidden shadow-lg hover:shadow-2xl transition-shadow">
              <% if gallery.images.any? %>
                <div class="relative h-48 bg-gray-200 overflow-hidden">
                  <img 
                    src="<%= gallery.images.first['url'] %>" 
                    alt="<%= gallery.title %>" 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                    loading="lazy"
                  />
                </div>
              <% else %>
                <div class="h-48 bg-gray-300 flex items-center justify-center">
                  <span class="text-gray-500">No images yet</span>
                </div>
              <% end %>
              
              <div class="p-4">
                <h2 class="text-xl font-semibold text-gray-900 mb-2 group-hover:text-blue-600">
                  <%= gallery.title %>
                </h2>
                <% if gallery.description.present? %>
                  <p class="text-gray-600 text-sm line-clamp-2">
                    <%= gallery.description %>
                  </p>
                <% end %>
                <div class="mt-4 text-sm text-gray-500">
                  <%= pluralize(gallery.images.count, 'image') %>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-12">
        <p class="text-slate-600 text-lg">No galleries available yet.</p>
      </div>
    <% end %>
  </div>
</div>
